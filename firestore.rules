rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content lives in a single document: site/content
    // Anyone can read it (so the portfolio is visible to visitors).
    // Only a signed-in user (your one admin account) can write to it.
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
