# Copy this file to .env and fill in your real values.
# .env is git-ignored — it never gets committed or pushed to GitHub.
# When you deploy to Vercel, add these same key/value pairs under
# Project → Settings → Environment Variables (Vercel doesn't read
# your local .env file — it needs its own copy).

# Firebase — Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — Dashboard (cloud name) + Settings → Upload → Upload presets (unsigned preset name)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
